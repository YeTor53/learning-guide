@echo off
chcp 936 >nul
title 断线重连演练（断网 8 秒）
setlocal

echo ============================================================
echo   断线重连演练 · 断网 8 秒（r004 / E18c）
echo ============================================================
echo.
echo 这个窗口只做倒计时提醒，不会改你的网络设置，也不会断你的网。
echo 断网与恢复都由你自己动手（关/开 Wi-Fi），这样最接近真实情况。
echo.
echo 准备：
echo   1) 浏览器开两个窗口进同一个房间（其中一个用无痕窗口，登录另一个账号）
echo   2) 两边都能看到对方，状态条显示「已连接」
echo   3) 记好你正在看的那一边（下面所有观察都在这一边看）
echo.
pause

echo.
echo   [1/3] 现在请【关闭 Wi-Fi / 拔网线 / 断开网络】——立刻！
echo.
for %%i in (8 7 6 5 4 3 2 1) do (
  echo     .. 还剩 %%i 秒（此时状态条应显示「正在重连…」，控制坞按钮应变灰）
  timeout /t 1 >nul
)

echo.
echo   [2/3] 现在请【打开 Wi-Fi / 恢复网络】！
echo         恢复后 1~5 秒内，状态条应自己回到「已连接」，不需要点任何按钮。
echo.
timeout /t 12 >nul

echo.
echo   [3/3] 请把下面四项回填到 docs/rounds/r004-room-extras/review.md 的 E18c：
echo         a) 断网后几秒出现「正在重连…」：____ 秒
echo         b) 断网期间地址栏是否仍是 /rooms/xxx/live：是 / 否
echo         c) 恢复后几秒回到「已连接」：____ 秒
echo         d) 断网前后麦克风 / 摄像头状态是否一致：是 / 否
echo.
echo   提示：若断网 8 秒后没有自动回房（出现「已断开」+「重新连接」按钮），
echo         把这一点也写上——这是我们要如实记录的边界，不是失败。
echo.
pause
endlocal
