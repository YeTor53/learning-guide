# 复制为 .env 后填真实值；.env 永不入库（键表见 docs/01-architecture/r001-app-architecture.md §5）
# 本机开发：后端 conda 环境 learningguide；数据库 PostgreSQL 17.11（服务 postgresql-x64-17）

# —— 必填 ——
DATABASE_URL=postgresql://lg_app:***@127.0.0.1:5432/learning_guide
SESSION_SECRET=<随机 32 字节 hex：python -c "import secrets;print(secrets.token_hex(32))">

# —— 应用（可选） ——
APP_ENV=dev
# CORS_ORIGINS=http://127.0.0.1:5173
ROOM_CAPACITY=8
# 限时邀请的有效期上限（秒，默认 60 —— 用户口径「最长 1 分钟」；改这里一个数）
INVITE_TTL_MAX_SECONDS=60

# —— LiveKit（M2 起；服务端专用，SECRET 绝不出现在前端） ——
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_MODE=cloud

# —— 纪要生成用 LLM（M4 起；OpenAI 兼容接口） ——
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
