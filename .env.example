# 复制为 .env 后填入真实值；.env 不入库
DATABASE_URL=postgresql://lg_app:<你的库密码>@127.0.0.1:5432/learning_guide

# LiveKit（服务端专用；SECRET 绝不出现在前端）
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 纪要生成用 LLM（OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 应用
SESSION_SECRET=<随机 32 字节 hex；由 agent 生成或你自己填>
ROOM_CAPACITY=8
INVITE_TTL_MINUTES=30
